# Kopieren nach ".env" und mit echten Werten füllen. ".env" wird nie eingecheckt (siehe .gitignore).

# Server
PORT=3000
# Öffentlich erreichbare Basis-URL (für Links in E-Mails und Stripe-Redirects). Lokal: http://localhost:3000
APP_BASE_URL=http://localhost:3000
# Zufälliger, langer, geheimer String zum Signieren der Session-Cookies (z. B. `openssl rand -hex 32`)
SESSION_SECRET=change-me-to-a-long-random-string

# SQLite-Datenbankdatei (optional, Default: ./data/novashop.sqlite)
# DATABASE_PATH=./data/novashop.sqlite

# Erstbefüllung des Admin-Accounts (nur für `npm run seed-admin` gebraucht, danach nicht mehr nötig
# — das Passwort wird als bcrypt-Hash in der DB gespeichert, nicht im Klartext).
ADMIN_EMAIL=admin@novashop.de
ADMIN_PASSWORD=change-me-before-seeding

# Stripe (https://dashboard.stripe.com/apikeys) — Testmodus-Keys reichen für die Entwicklung.
STRIPE_SECRET_KEY=
# Webhook-Signing-Secret aus `stripe listen` bzw. dem Dashboard-Webhook-Endpoint (Event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=

# Brevo (https://app.brevo.com/settings/keys/api) — ein Account für Transaktionsmails + Newsletter.
BREVO_API_KEY=
# Muss eine in Brevo verifizierte Absenderadresse sein.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=NovaShop
# ID der Newsletter-Kontaktliste in Brevo (Kampagnen -> Kontakte -> Listen)
BREVO_NEWSLETTER_LIST_ID=
